// Schema minimale per il v1 snello del Proposal Generator: solo il modello
// Lead. Google Sheets/Drive, AI e admin dashboard sono volutamente fuori
// scope finché il sistema non è validato con lead reali.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id        String   @id @default(cuid())

  // Dati di contatto
  nome      String
  email     String
  telefono  String?
  azienda   String?

  // Risposte quiz + proposta generata (JSON, non normalizzato: v1 non ha
  // bisogno di query complesse, solo di leggere/esportare il lead).
  responses      Json
  recommendation Json

  // Stato di follow-up manuale (aggiornato a mano finché non c'è una dashboard)
  status    String   @default("new") // new | contacted | qualified | converted | rejected
  notes     String?

  // Tracciabilità invio email
  emailClientSent Boolean @default(false)
  emailTeamSent   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
}
