# Copia questo file in .env.local e inserisci i valori reali.
# .env.local non viene mai committato (vedi .gitignore).

# Database Postgres per i lead del quiz (es. Vercel Postgres, Neon, Supabase).
# Su Supabase usare il connection pooler (porta 6543) con ?pgbouncer=true.
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
# Richiesta da `prisma migrate`/`db push`: connessione in session-mode (porta 5432
# sul pooler, o connessione diretta se raggiungibile dalla rete).
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Resend (https://resend.com) per l'invio email cliente + notifica team.
RESEND_API_KEY=""
# Indirizzo mittente: deve appartenere a un dominio verificato su Resend.
RESEND_FROM_EMAIL="proposte@tuodominio.it"
# Chi riceve la notifica di nuovo lead. Se vuoto, usa site.email da lib/data.js.
TEAM_NOTIFICATION_EMAIL=""
